{
  "name": "bouncer-gates",
  "version": "0.5.0",
  "mcpName": "io.github.ajeermahmood/bouncer-gates",
  "description": "CI gates that let anyone contribute to a codebase without being able to break it.",
  "type": "module",
  "license": "MIT",
  "author": "Ajeer Mohammed",
  "repository": {
    "type": "git",
    "url": "https://github.com/ajeermahmood/bouncer-gates"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "bouncer-gates": "./bin/bouncer-gates.mjs"
  },
  "files": [
    "bin",
    "gates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node bin/bouncer-gates.mjs",
    "check:changed": "node bin/bouncer-gates.mjs --changed",
    "baseline": "node bin/bouncer-gates.mjs --baseline-write",
    "bench": "node tools/bench.mjs",
    "stats": "node tools/stats.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "serve": "node server/index.mjs"
  },
  "devDependencies": {
    "@astrojs/react": "^4.4.2",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.3",
    "astro": "^5.16.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.3",
    "sass": "^1.86.3",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "ci",
    "lint",
    "guardrails",
    "multi-tenant",
    "security",
    "secrets",
    "migrations",
    "code-review",
    "devtools",
    "mcp",
    "claude-code",
    "cursor",
    "ai-agents"
  ],
  "homepage": "https://bouncer-gates.ajeermdk001.workers.dev",
  "bugs": {
    "url": "https://github.com/ajeermahmood/bouncer-gates/issues"
  }
}
