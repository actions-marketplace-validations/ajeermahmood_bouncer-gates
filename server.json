{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.ajeermahmood/bouncer",
  "description": "Stops secrets, cross-tenant queries and unsafe migrations before they merge.",
  "repository": {
    "url": "https://github.com/ajeermahmood/bouncer",
    "source": "github"
  },
  "version": "0.4.1",
  "websiteUrl": "https://bouncer.ajeermdk001.workers.dev",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "bouncer-gates",
      "version": "0.4.1",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "named",
          "name": "--mcp",
          "description": "Serve the gates over MCP instead of running the CLI once.",
          "isRequired": true
        }
      ]
    }
  ]
}
